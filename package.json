{
  "name": "magpie-tokensci",
  "version": "0.2.2",
  "description": "Report actual Magpie models to tokens.ci and exclude their aliases from local submissions",
  "type": "module",
  "main": "./index.mjs",
  "bin": { "magpie-tokensci": "./cli.mjs" },
  "engines": { "node": ">=22" },
  "scripts": { "test": "node --test test/*.test.mjs" },
  "dependencies": { "tokens-cli": "27.2.1" },
  "license": "MIT",
  "author": "galentwww",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galentwww/magpie-tokensci.git"
  },
  "homepage": "https://github.com/galentwww/magpie-tokensci#readme",
  "bugs": {
    "url": "https://github.com/galentwww/magpie-tokensci/issues"
  },
  "files": [
    "index.mjs",
    "cli.mjs",
    "accounting.mjs",
    "reporter.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "tokens",
    "tokens.ci"
  ],
  "magpie": {
    "name": "tokens.ci",
    "summary": {
